{
  "schemaVersion": 1,
  "id": "exposure",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_page}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.mortuusars.exposure.fabric.ExposureFabric"
    ],
    "client": [
      "io.github.mortuusars.exposure.fabric.ExposureFabricClient"
    ]
  },
  "accessWidener": "exposure.accesswidener",
  "mixins": [
    "exposure.mixins.json",
    "exposure-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}",
    "forgeconfigapiport": ">=${forge_config_api_port_version}"
  },
  "suggests": {
    "jei": "*",
    "jade": "*"
  }
}
