{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:condition", "property": "exposure:camera_gold",
          "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_gold_gui", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]},
          "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_gui", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]}
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition", "property": "exposure:camera_selfie_user",
      "on_true": {"type": "minecraft:model", "model": "exposure:item/selfie_stick"},
      "on_false": {
        "type": "minecraft:condition", "property": "exposure:camera_selfie",
        "on_true": {
          "type": "exposure:shared_transform_composite", "models": [
            {
              "type": "minecraft:condition", "property": "exposure:camera_gold",
              "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_gold_selfie", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]},
              "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_selfie", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]}
            },
            {
              "type": "minecraft:condition", "property": "exposure:camera_gold",
              "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_parts/selfie_stick"},
              "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_parts/selfie_stick"}
            },
            {
              "type": "minecraft:condition", "property": "exposure:camera_has_flash",
              "on_true": {
                "type": "minecraft:condition", "property": "exposure:camera_gold",
                "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_parts/flash_gold"},
                "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_parts/flash"}
              },
              "on_false": {"type": "minecraft:empty"}
            },
            {
              "type": "minecraft:condition", "property": "exposure:camera_has_lens",
              "on_true": {
                "type": "minecraft:condition", "property": "exposure:camera_gold",
                "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_parts/lens_gold", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]},
                "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_parts/lens", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]}
              },
              "on_false": {"type": "minecraft:empty"}
            }
          ]
        },
        "on_false": {
          "type": "minecraft:condition", "property": "exposure:camera_active",
          "on_true": {
            "type": "exposure:shared_transform_composite", "models": [
              {
                "type": "minecraft:condition", "property": "exposure:camera_gold",
                "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_gold_active", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]},
                "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_active", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]}
              },
              {
                "type": "minecraft:condition", "property": "exposure:camera_gold",
                "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_parts/viewfinder_gold"},
                "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_parts/viewfinder"}
              },
              {
                "type": "minecraft:condition", "property": "exposure:camera_has_flash",
                "on_true": {
                  "type": "minecraft:condition", "property": "exposure:camera_gold",
                  "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_parts/flash_gold"},
                  "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_parts/flash"}
                },
                "on_false": {"type": "minecraft:empty"}
              },
              {
                "type": "minecraft:condition", "property": "exposure:camera_has_lens",
                "on_true": {
                  "type": "minecraft:condition", "property": "exposure:camera_gold",
                  "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_parts/lens_gold", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]},
                  "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_parts/lens", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]}
                },
                "on_false": {"type": "minecraft:empty"}
              }
            ]
          },
          "on_false": {
            "type": "exposure:shared_transform_composite", "models": [
              {
                "type": "minecraft:condition", "property": "exposure:camera_gold",
                "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_gold", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]},
                "on_false": {"type": "minecraft:model", "model": "exposure:item/camera", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]}
              },
              {
                "type": "minecraft:condition", "property": "exposure:camera_has_flash",
                "on_true": {
                  "type": "minecraft:condition", "property": "exposure:camera_gold",
                  "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_parts/flash_gold"},
                  "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_parts/flash"}
                },
                "on_false": {"type": "minecraft:empty"}
              },
              {
                "type": "minecraft:condition", "property": "exposure:camera_has_lens",
                "on_true": {
                  "type": "minecraft:condition", "property": "exposure:camera_gold",
                  "on_true": {"type": "minecraft:model", "model": "exposure:item/camera_parts/lens_gold", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]},
                  "on_false": {"type": "minecraft:model", "model": "exposure:item/camera_parts/lens", "tints": [{"type": "minecraft:constant", "value": -1}, {"type": "exposure:camera_glass"}]}
                },
                "on_false": {"type": "minecraft:empty"}
              }
            ]
          }
        }
      }
    }
  }
}
